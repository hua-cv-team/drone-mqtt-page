# DJI Cloud API licence (developer.dji.com -> Apps)
DJI_APP_ID=
DJI_APP_KEY=
DJI_LICENSE=

# Broker the controller sends telemetry to, e.g. tcp://broker.example.com:1883
BROKER_HOST=
BROKER_USER=
BROKER_PASS=

# Watcher: broker it connects to. Empty = local test broker (broker:1883, pilot/pilot123)
WATCH_HOST=
WATCH_PORT=
WATCH_TLS=
WATCH_USER=
WATCH_PASS=
# Reply to Pilot 2's update_topo (true/false). Empty = true
REPLY_TOPO=
